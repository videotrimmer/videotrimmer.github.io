---
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPath(lang);
---

<div class="mx-auto max-w-6xl space-y-16 px-4 py-14 sm:px-6 lg:px-8">
  <!-- Visual Breadcrumbs Navigation (Maps 1:1 to BreadcrumbList JSON-LD Schema) -->
  <nav aria-label="Breadcrumb" class="rounded-2xl border border-[#64A97B]/40 bg-[var(--workspace-box-bg)] px-4 py-2.5 shadow-sm">
    <ol class="flex flex-wrap items-center gap-2 text-sm font-bold text-[var(--text-secondary)]">
      <li>
        <a href={homeUrl} class="hover:text-[#64A97B] hover:underline">{t('breadcrumb.home')}</a>
      </li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={`${homeUrl}#tools`} class="hover:text-[#64A97B] hover:underline">{t('breadcrumb.tools')}</a>
      </li>
      <li aria-hidden="true">/</li>
      <li class="text-[var(--text-primary)] font-extrabold" aria-current="page">
        {t('breadcrumb.current')}
      </li>
    </ol>
  </nav>

  <!-- Features Grid -->
  <section id="tools" aria-labelledby="features-heading" class="space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <h2 id="features-heading" class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--text-primary)] mb-3">
        {t('features.title')}
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] font-medium">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <!-- Card 1 -->
      <article class="rounded-3xl border-2 border-[#64A97B] bg-[var(--bg-surface-card)] p-6 shadow-md transition-transform hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#3A5465] text-[#D4ED9D]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-extrabold text-[var(--text-primary)]">
          {t('features.card1Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]/90">
          {t('features.card1Desc')}
        </p>
      </article>

      <!-- Card 2 -->
      <article class="rounded-3xl border-2 border-[#64A97B] bg-[var(--bg-surface-card)] p-6 shadow-md transition-transform hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#3A5465] text-[#D4ED9D]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-extrabold text-[var(--text-primary)]">
          {t('features.card2Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]/90">
          {t('features.card2Desc')}
        </p>
      </article>

      <!-- Card 3 -->
      <article class="rounded-3xl border-2 border-[#64A97B] bg-[var(--bg-surface-card)] p-6 shadow-md transition-transform hover:-translate-y-1">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#3A5465] text-[#D4ED9D]">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
        </div>
        <h3 class="mb-2 text-xl font-extrabold text-[var(--text-primary)]">
          {t('features.card3Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]/90">
          {t('features.card3Desc')}
        </p>
      </article>
    </div>
  </section>

  <!-- How-To 3 Steps Section (Mapped to HowTo JSON-LD Schema) -->
  <section aria-labelledby="howto-heading" class="rounded-3xl border-2 border-[#64A97B] bg-[var(--workspace-box-bg)] p-6 sm:p-10 shadow-lg">
    <h2 id="howto-heading" class="mb-8 text-center text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
      {t('howto.title')}
    </h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-5">
        <h3 class="mb-2 text-lg font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('howto.step1Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]">
          {t('howto.step1Desc')}
        </p>
      </article>
      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-5">
        <h3 class="mb-2 text-lg font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('howto.step2Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]">
          {t('howto.step2Desc')}
        </p>
      </article>
      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-5">
        <h3 class="mb-2 text-lg font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('howto.step3Title')}
        </h3>
        <p class="text-base text-[var(--text-primary)]">
          {t('howto.step3Desc')}
        </p>
      </article>
    </div>
  </section>

  <!-- LosslessCut / VLC vs. Cloud Trimmer Comparison Table -->
  <section aria-labelledby="comparison-heading" class="space-y-6">
    <div class="text-center max-w-3xl mx-auto">
      <h2 id="comparison-heading" class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)] mb-2">
        {t('comp.title')}
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] font-medium">
        {t('comp.subtitle')}
      </p>
    </div>

    <div class="overflow-x-auto rounded-3xl border-2 border-[#64A97B] bg-[var(--workspace-box-bg)] shadow-lg">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm sm:text-base">
        <thead>
          <tr class="border-b-2 border-[#64A97B] bg-[#3A5465] text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]">
            <th scope="col" class="px-5 py-4 font-extrabold">{t('comp.colFeature')}</th>
            <th scope="col" class="px-5 py-4 font-extrabold bg-[#64A97B] text-white">{t('comp.colVideoTrimmer')}</th>
            <th scope="col" class="px-5 py-4 font-bold">{t('comp.colCloud')}</th>
            <th scope="col" class="px-5 py-4 font-bold">{t('comp.colVlc')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#64A97B]/30">
          {
            [1, 2, 3, 4].map((row) => (
              <tr class="hover:bg-[#D4ED9D]/20 transition-colors">
                <th scope="row" class="px-5 py-4 font-extrabold text-[var(--text-primary)]">
                  {t(`comp.row${row}Name`)}
                </th>
                <td class="px-5 py-4 font-extrabold text-[#3A5465] bg-[#D4ED9D]/35 dark:bg-[#3A5465]/40 dark:text-[#D4ED9D]">
                  ✓ {t(`comp.row${row}Val1`)}
                </td>
                <td class="px-5 py-4 text-[var(--text-secondary)]">
                  {t(`comp.row${row}Val2`)}
                </td>
                <td class="px-5 py-4 text-[var(--text-secondary)]">
                  {t(`comp.row${row}Val3`)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Keyword-Rich Semantic SEO Guide Articles -->
  <section aria-labelledby="seo-guide-heading" class="rounded-3xl border-2 border-[#64A97B] bg-[var(--workspace-box-bg)] p-6 sm:p-10 shadow-md space-y-8">
    <div class="max-w-4xl mx-auto text-center space-y-3">
      <h2 id="seo-guide-heading" class="text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
        {t('seo.guideTitle')}
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-secondary)]">
        {t('seo.guideIntro')}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-6 space-y-2.5">
        <h3 class="text-xl font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('seo.sec1Title')}
        </h3>
        <p class="text-base leading-relaxed text-[var(--text-primary)]">
          {t('seo.sec1Body')}
        </p>
      </article>

      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-6 space-y-2.5">
        <h3 class="text-xl font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('seo.sec2Title')}
        </h3>
        <p class="text-base leading-relaxed text-[var(--text-primary)]">
          {t('seo.sec2Body')}
        </p>
      </article>

      <article class="rounded-2xl border border-[#64A97B]/50 bg-[var(--card-subtle-bg)] p-6 space-y-2.5">
        <h3 class="text-xl font-extrabold text-[#3A5465] dark:text-[#D4ED9D]">
          {t('seo.sec3Title')}
        </h3>
        <p class="text-base leading-relaxed text-[var(--text-primary)]">
          {t('seo.sec3Body')}
        </p>
      </article>
    </div>
  </section>

  <!-- SEO FAQ Section (Mapped 1:1 to FAQPage JSON-LD Schema) -->
  <section aria-labelledby="faq-heading" class="space-y-6">
    <h2 id="faq-heading" class="text-center text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
      {t('faq.title')}
    </h2>
    <div class="mx-auto max-w-4xl space-y-4">
      {
        [1, 2, 3, 4, 5].map((num) => (
          <details class="group rounded-2xl border-2 border-[#64A97B] bg-[var(--workspace-box-bg)] p-5 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-extrabold text-[var(--text-primary)]">
              <span>{t(`faq.q${num}`)}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#D4ED9D] text-[#3D3931] transition-transform group-open:rotate-180 dark:bg-[#3A5465] dark:text-[#D4ED9D]">
                ▼
              </span>
            </summary>
            <p class="mt-3 border-t border-[#64A97B]/30 pt-3 text-base text-[var(--text-secondary)]">
              {t(`faq.a${num}`)}
            </p>
          </details>
        ))
      }
    </div>
  </section>
</div>
