---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="first-fold-hero mx-auto w-full max-w-6xl px-3 py-4 sm:px-6 sm:py-6 lg:px-8"
  aria-labelledby="hero-primary-h1"
>
  <!-- Primary H1 -->
  <div class="mb-4 text-center sm:mb-5">
    <h1
      id="hero-primary-h1"
      class="font-extrabold tracking-tight text-[var(--text-primary)]"
    >
      {t('hero.h1')}
    </h1>
  </div>

  <!-- Interactive Trimmer Box Div -->
  <div
    id="video-trimmer-workspace"
    class="relative rounded-3xl border-2 border-[#64A97B] bg-[var(--workspace-box-bg)] p-4 sm:p-6 lg:p-7 shadow-workspace dark:shadow-workspace-dark transition-all duration-300"
    data-i18n-lossless-status={t('progress.losslessStatus')}
    data-i18n-precision-status={t('progress.precisionStatus')}
    data-i18n-audio-status={t('progress.audioStatus')}
    data-i18n-loading-engine={t('progress.loadingEngine')}
    data-i18n-original={t('result.originalLabel')}
    data-i18n-trimmed={t('result.trimmedLabel')}
    data-i18n-zero-loss={t('result.zeroLossBadge')}
    data-i18n-play={t('controls.playSelection')}
    data-i18n-pause={t('controls.pause')}
    data-i18n-trim-btn={t('controls.trimActionBtn')}
    data-i18n-cut-btn={t('controls.cutMiddleActionBtn')}
    data-i18n-extract-btn={t('controls.extractActionBtn')}
    data-i18n-dl-video={t('result.downloadVideoBtn')}
    data-i18n-dl-audio={t('result.downloadAudioBtn')}
    data-i18n-keep-label={t('controls.timelineKeepLabel')}
    data-i18n-remove-label={t('controls.timelineRemoveMiddleLabel')}
    data-i18n-mode-trim-desc={t('mode.trimVideoDesc')}
    data-i18n-mode-cut-desc={t('mode.cutMiddleDesc')}
    data-i18n-mode-mobile-desc={t('mode.mobileVideoDesc')}
    data-i18n-mode-audio-desc={t('mode.trimAudioDesc')}
    data-i18n-mode-extract-desc={t('mode.extractMp3Desc')}
  >
    <!-- Collapsible Mode Presets Bar -->
    <div class="mb-4">
      <div class="flex items-center justify-center">
        <button
          type="button"
          id="mode-presets-toggle-btn"
          aria-expanded="false"
          aria-controls="mode-presets-collapse-panel"
          class="inline-flex items-center gap-2.5 rounded-2xl border-2 border-[#64A97B] bg-[var(--card-subtle-bg)] px-4 py-2 text-sm sm:text-base font-extrabold text-[var(--text-primary)] shadow-sm transition-all duration-200 hover:border-[#3A5465] hover:bg-[#D4ED9D]/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#64A97B]"
        >
          <svg class="h-4 w-4 shrink-0 text-[#3A5465] dark:text-[#D4ED9D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="6" cy="6" r="3" />
            <circle cx="6" cy="18" r="3" />
            <line x1="20" y1="4" x2="8.12" y2="15.88" />
            <line x1="14.47" y1="14.48" x2="20" y2="20" />
            <line x1="8.12" y1="8.12" x2="12" y2="12" />
          </svg>
          <span id="active-mode-label-text">{t('mode.trimVideo')}</span>
          <svg
            id="mode-presets-chevron"
            class="h-4 w-4 shrink-0 text-[#3A5465] transition-transform duration-200 dark:text-[#D4ED9D]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
      </div>

      <!-- Hidden by default: Mode Selector Pills + Active Mode Description -->
      <div
        id="mode-presets-collapse-panel"
        class="hidden mt-3 rounded-2xl border-2 border-[#64A97B]/40 bg-[var(--card-subtle-bg)] p-3.5 transition-all"
      >
        <div
          role="tablist"
          aria-label="Video Trimmer Modes"
          class="flex flex-wrap items-center justify-center gap-2"
        >
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-mode="trim-video"
            class="mode-pill active-mode flex items-center gap-2 rounded-2xl border-2 border-[#3A5465] bg-[#3A5465] px-4 py-2 text-sm font-extrabold text-white shadow-md transition-all duration-200 hover:bg-[#64A97B] dark:border-[#D4ED9D] dark:bg-[#D4ED9D] dark:text-[#3D3931]"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="6" r="3" />
              <circle cx="6" cy="18" r="3" />
              <line x1="20" y1="4" x2="8.12" y2="15.88" />
              <line x1="14.47" y1="14.48" x2="20" y2="20" />
              <line x1="8.12" y1="8.12" x2="12" y2="12" />
            </svg>
            <span>{t('mode.trimVideo')}</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-mode="cut-middle"
            class="mode-pill flex items-center gap-2 rounded-2xl border-2 border-[#64A97B] bg-[#F7FBF2] px-4 py-2 text-sm font-bold text-[#3D3931] transition-all duration-200 hover:border-[#3A5465] hover:bg-[#D4ED9D]/60 dark:bg-[#3D3931] dark:text-[#F7FBF2] dark:hover:bg-[#64A97B]/40"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="5" width="6" height="14" rx="1.5" />
              <rect x="16" y="5" width="6" height="14" rx="1.5" />
              <path d="M10 9l4 6M14 9l-4 6" />
            </svg>
            <span>{t('mode.cutMiddle')}</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-mode="mobile-video"
            class="mode-pill flex items-center gap-2 rounded-2xl border-2 border-[#64A97B] bg-[#F7FBF2] px-4 py-2 text-sm font-bold text-[#3D3931] transition-all duration-200 hover:border-[#3A5465] hover:bg-[#D4ED9D]/60 dark:bg-[#3D3931] dark:text-[#F7FBF2] dark:hover:bg-[#64A97B]/40"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="2" width="12" height="20" rx="2" />
              <line x1="12" y1="18" x2="12.01" y2="18" />
            </svg>
            <span>{t('mode.mobileVideo')}</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-mode="trim-audio"
            class="mode-pill flex items-center gap-2 rounded-2xl border-2 border-[#64A97B] bg-[#F7FBF2] px-4 py-2 text-sm font-bold text-[#3D3931] transition-all duration-200 hover:border-[#3A5465] hover:bg-[#D4ED9D]/60 dark:bg-[#3D3931] dark:text-[#F7FBF2] dark:hover:bg-[#64A97B]/40"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 10v3" />
              <path d="M6 6v11" />
              <path d="M10 3v18" />
              <path d="M14 8v7" />
              <path d="M18 5v13" />
              <path d="M22 10v3" />
            </svg>
            <span>{t('mode.trimAudio')}</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-mode="extract-mp3"
            class="mode-pill flex items-center gap-2 rounded-2xl border-2 border-[#64A97B] bg-[#F7FBF2] px-4 py-2 text-sm font-bold text-[#3D3931] transition-all duration-200 hover:border-[#3A5465] hover:bg-[#D4ED9D]/60 dark:bg-[#3D3931] dark:text-[#F7FBF2] dark:hover:bg-[#64A97B]/40"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
            <span>{t('mode.extractMp3')}</span>
          </button>
        </div>

        <!-- Active Mode Helper Description -->
        <p
          id="active-mode-description"
          class="mt-2.5 text-center text-xs sm:text-sm font-semibold text-[var(--text-secondary)]"
        >
          {t('mode.trimVideoDesc')}
        </p>
      </div>
    </div>

    <!-- Hidden File Input (Supports Batch Selection) -->
    <input
      type="file"
      id="trimmer-file-input"
      multiple
      accept="video/*,audio/*,.mp4,.mov,.webm,.mkv,.avi,.m4v,.mp3,.wav,.m4a,.ogg,.flac,.aac"
      class="sr-only"
    />

    <!-- ==========================================
         STEP 1: GIANT DROPZONE
         ========================================== -->
    <div
      id="step-1-dropzone"
      class="float-smooth group relative flex flex-col items-center justify-center rounded-3xl border-[3px] border-dashed border-[#64A97B] bg-[var(--dropzone-bg)] px-5 py-8 sm:py-12 text-center transition-all duration-300 hover:border-[#3A5465] hover:bg-[var(--dropzone-hover-bg)] cursor-pointer"
    >
      <!-- Highlight Pill Badge -->
      <div
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#64A97B] bg-[#D4ED9D] px-4 py-1.5 text-xs sm:text-sm font-extrabold text-[#3D3931] shadow-sm dark:bg-[#3D3931] dark:text-[#D4ED9D]"
      >
        <svg class="h-4 w-4 text-[#3A5465] dark:text-[#D4ED9D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
        </svg>
        <span>{t('dropzone.badge')}</span>
      </div>

      <!-- Oversized 64x64px SVG Icon -->
      <div
        class="mb-4 flex h-20 w-20 items-center justify-center rounded-2xl bg-[#D4ED9D] text-[#3A5465] shadow-md transition-transform duration-300 group-hover:scale-110 group-hover:bg-[#64A97B] group-hover:text-white dark:bg-[#3A5465] dark:text-[#D4ED9D]"
      >
        <svg
          class="h-14 w-14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="3" width="20" height="14" rx="2.5" />
          <path d="M10 8l5 3-5 3V8z" fill="currentColor" />
          <path d="M4 21h16" />
          <path d="M8 19v2" />
          <path d="M16 19v2" />
          <path d="M12 18v3" />
        </svg>
      </div>

      <h2 class="mb-2 text-xl sm:text-2xl lg:text-3xl font-extrabold text-[var(--text-primary)]">
        {t('dropzone.title')}
      </h2>
      <p class="mb-6 max-w-2xl text-base sm:text-lg font-medium text-[var(--text-secondary)]">
        {t('dropzone.subtitle')}
      </p>

      <!-- Action Button Row -->
      <div class="flex flex-wrap items-center justify-center">
        <button
          type="button"
          id="select-video-btn"
          class="inline-flex items-center gap-3 rounded-2xl bg-[#3A5465] px-8 py-4 text-lg sm:text-xl font-extrabold text-white shadow-btn transition-all duration-200 hover:bg-[#64A97B] hover:-translate-y-0.5 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#64A97B] dark:bg-[#D4ED9D] dark:text-[#3D3931] dark:hover:bg-[#64A97B] dark:hover:text-white"
        >
          <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
          <span>{t('dropzone.selectBtn')}</span>
        </button>
      </div>
    </div>

    <!-- ==========================================
         STEP 2: VISUAL TIMELINE CONTROLS & PRESETS
         ========================================== -->
    <div id="step-2-controls" class="hidden space-y-5">
      <!-- Top Loaded Files / Batch Queue Bar -->
      <div
        class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border-2 border-[#64A97B]/50 bg-[var(--card-subtle-bg)] px-4 py-2.5"
      >
        <div class="flex flex-wrap items-center gap-2" id="batch-file-pills">
          <!-- Populated dynamically with file pills -->
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="add-more-files-btn"
            class="rounded-xl border border-[#64A97B] bg-[#D4ED9D]/60 px-3 py-1.5 text-sm font-bold text-[#3D3931] transition hover:bg-[#64A97B] hover:text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]"
          >
            {t('controls.addMoreFiles')}
          </button>
          <button
            type="button"
            id="replace-file-btn"
            class="rounded-xl border border-[#3A5465] bg-[#3A5465] px-3 py-1.5 text-sm font-bold text-white transition hover:bg-[#64A97B] dark:bg-[#D4ED9D] dark:text-[#3D3931]"
          >
            {t('controls.changeFile')}
          </button>
        </div>
      </div>

      <!-- Main Video Player + Quick Playback Bar -->
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-12">
        <!-- Left 7 cols: Live HTML5 Video Player -->
        <div class="lg:col-span-7 flex flex-col justify-between rounded-2xl border-2 border-[#64A97B] bg-[#182229] p-3 shadow-inner">
          <div class="relative flex aspect-video w-full items-center justify-center overflow-hidden rounded-xl bg-black">
            <video
              id="source-video-player"
              class="max-h-[340px] w-full object-contain"
              playsinline
              preload="metadata"
            ></video>

            <!-- Audio-Only Visualizer Overlay (shown when trimming MP3/WAV) -->
            <div
              id="audio-only-overlay"
              class="hidden absolute inset-0 flex flex-col items-center justify-center bg-gradient-to-br from-[#3A5465] to-[#23211C] text-[#D4ED9D] p-6"
            >
              <svg class="h-16 w-16 mb-3 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 18V5l12-2v13" />
                <circle cx="6" cy="18" r="3" />
                <circle cx="18" cy="16" r="3" />
              </svg>
              <p id="audio-file-title" class="text-lg font-extrabold text-white truncate max-w-md"></p>
            </div>

            <!-- Live Timecode Floating Pill -->
            <div
              class="pointer-events-none absolute top-3 right-3 rounded-lg bg-[#3D3931]/90 border border-[#64A97B] px-3 py-1 font-mono text-sm font-bold text-[#D4ED9D]"
            >
              <span id="live-playhead-readout">00:00.0</span> / <span id="total-duration-readout">00:00.0</span>
            </div>
          </div>

          <!-- Player Transport Controls -->
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 px-1">
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="play-selection-btn"
                class="inline-flex items-center gap-2 rounded-xl bg-[#64A97B] px-4 py-2 text-sm sm:text-base font-extrabold text-white shadow transition hover:bg-[#D4ED9D] hover:text-[#3D3931]"
              >
                <svg id="play-icon-svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <polygon points="5 3 19 12 5 21 5 3" />
                </svg>
                <span id="play-selection-label">{t('controls.playSelection')}</span>
              </button>

              <label class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-[#64A97B]/60 bg-[#2C3E4A] px-3 py-2 text-xs sm:text-sm font-bold text-[#F7FBF2]">
                <input
                  type="checkbox"
                  id="loop-selection-checkbox"
                  checked
                  class="h-4 w-4 accent-[#D4ED9D] rounded"
                />
                <span>{t('controls.loopToggle')}</span>
              </label>
            </div>

            <button
              type="button"
              id="reset-range-btn"
              class="rounded-xl border border-[#64A97B]/60 bg-[#2C3E4A] px-3 py-2 text-xs sm:text-sm font-bold text-[#D4ED9D] transition hover:bg-[#64A97B] hover:text-white"
            >
              {t('controls.resetRange')}
            </button>
          </div>
        </div>

        <!-- Right 5 cols: Exact Timecode Inputs & Fine-Tune Nudge Controls -->
        <div class="lg:col-span-5 flex flex-col justify-between rounded-2xl border-2 border-[#64A97B] bg-[var(--card-subtle-bg)] p-4">
          <div class="space-y-4">
            <!-- Start Time Box -->
            <div class="rounded-xl border-2 border-[#64A97B]/60 bg-[var(--workspace-box-bg)] p-3">
              <div class="mb-1.5 flex items-center justify-between">
                <label for="start-time-input" class="text-sm font-extrabold uppercase tracking-wider text-[var(--text-secondary)]">
                  {t('controls.startTime')} (00:00.0)
                </label>
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    id="nudge-start-minus"
                    aria-label={`${t('controls.startTime')} ${t('controls.nudgeMinus')}`}
                    class="rounded-lg border border-[#64A97B] bg-[#D4ED9D]/60 px-2.5 py-1 font-mono text-xs font-extrabold text-[#3D3931] transition hover:bg-[#64A97B] hover:text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]"
                  >
                    {t('controls.nudgeMinus')}
                  </button>
                  <button
                    type="button"
                    id="nudge-start-plus"
                    aria-label={`${t('controls.startTime')} ${t('controls.nudgePlus')}`}
                    class="rounded-lg border border-[#64A97B] bg-[#D4ED9D]/60 px-2.5 py-1 font-mono text-xs font-extrabold text-[#3D3931] transition hover:bg-[#64A97B] hover:text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]"
                  >
                    {t('controls.nudgePlus')}
                  </button>
                </div>
              </div>
              <input
                type="text"
                id="start-time-input"
                value="00:00.0"
                aria-label={t('controls.startTime')}
                class="w-full rounded-xl border-2 border-[#64A97B]/50 bg-[var(--bg-primary)] px-3.5 py-2 font-mono text-xl font-extrabold text-[var(--text-primary)] focus:border-[#3A5465] focus:outline-none"
              />
            </div>

            <!-- End Time Box -->
            <div class="rounded-xl border-2 border-[#64A97B]/60 bg-[var(--workspace-box-bg)] p-3">
              <div class="mb-1.5 flex items-center justify-between">
                <label for="end-time-input" class="text-sm font-extrabold uppercase tracking-wider text-[var(--text-secondary)]">
                  {t('controls.endTime')} (00:00.0)
                </label>
                <div class="flex items-center gap-1.5">
                  <button
                    type="button"
                    id="nudge-end-minus"
                    aria-label={`${t('controls.endTime')} ${t('controls.nudgeMinus')}`}
                    class="rounded-lg border border-[#64A97B] bg-[#D4ED9D]/60 px-2.5 py-1 font-mono text-xs font-extrabold text-[#3D3931] transition hover:bg-[#64A97B] hover:text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]"
                  >
                    {t('controls.nudgeMinus')}
                  </button>
                  <button
                    type="button"
                    id="nudge-end-plus"
                    aria-label={`${t('controls.endTime')} ${t('controls.nudgePlus')}`}
                    class="rounded-lg border border-[#64A97B] bg-[#D4ED9D]/60 px-2.5 py-1 font-mono text-xs font-extrabold text-[#3D3931] transition hover:bg-[#64A97B] hover:text-white dark:bg-[#3D3931] dark:text-[#D4ED9D]"
                  >
                    {t('controls.nudgePlus')}
                  </button>
                </div>
              </div>
              <input
                type="text"
                id="end-time-input"
                value="00:10.0"
                aria-label={t('controls.endTime')}
                class="w-full rounded-xl border-2 border-[#64A97B]/50 bg-[var(--bg-primary)] px-3.5 py-2 font-mono text-xl font-extrabold text-[var(--text-primary)] focus:border-[#3A5465] focus:outline-none"
              />
            </div>
          </div>

          <!-- Selected Duration Summary Pill -->
          <div
            aria-live="polite"
            class="mt-3 flex items-center justify-between rounded-xl bg-[#D4ED9D] px-4 py-3 text-[#3D3931] dark:bg-[#3D3931] dark:text-[#D4ED9D]"
          >
            <span id="duration-summary-label" class="text-sm font-extrabold uppercase tracking-wide">
              {t('controls.keptDuration')}:
            </span>
            <span id="selected-duration-badge" aria-live="polite" class="font-mono text-xl font-extrabold">
              00:10.00 (10.0s)
            </span>
          </div>
        </div>
      </div>

      <!-- Giant Dual-Handle Visual Timeline Bar -->
      <div class="rounded-2xl border-2 border-[#64A97B] bg-[var(--card-subtle-bg)] p-4">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm font-bold text-[var(--text-secondary)]">
          <span id="timeline-mode-badge" class="inline-flex items-center gap-1.5 rounded-lg bg-[#64A97B] px-2.5 py-0.5 text-xs font-extrabold text-white">
            {t('controls.timelineKeepLabel')}
          </span>
          <span>{t('controls.keyboardHint')}</span>
        </div>

        <!-- Timeline Track -->
        <div
          id="timeline-track"
          class="timeline-track-container my-3"
          role="group"
          aria-label="Dual-Handle Video Trim Timeline"
        >
          <!-- Filmstrip Thumbnail Strip Background -->
          <div
            id="timeline-filmstrip"
            class="pointer-events-none absolute inset-0 flex overflow-hidden rounded-[14px] opacity-65"
          ></div>

          <!-- Cut-Middle Mode Left & Right Kept Overlays -->
