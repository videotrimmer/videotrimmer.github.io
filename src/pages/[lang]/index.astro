---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoTrimmerBox from '../../components/VideoTrimmerBox.astro';
import SeoContentSection from '../../components/SeoContentSection.astro';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({
      params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Lang };
---

<BaseLayout lang={lang}>
  <VideoTrimmerBox lang={lang} />
  <SeoContentSection lang={lang} />
</BaseLayout>
